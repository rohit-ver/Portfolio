<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1E1B4B"/>
      <stop offset="50%" stop-color="#0F172A"/>
      <stop offset="100%" stop-color="#0E7490"/>
    </linearGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4F46E5"/>
      <stop offset="50%" stop-color="#06B6D4"/>
      <stop offset="100%" stop-color="#8B5CF6"/>
    </linearGradient>
  </defs>

  <!-- Outer background circle -->
  <circle cx="200" cy="200" r="195" fill="url(#bgGrad)"/>
  <circle cx="200" cy="200" r="185" fill="none" stroke="url(#ringGrad)" stroke-width="6" opacity="0.8"/>

  <!-- Developer Silhouette / Avatar Illustration -->
  <!-- Shoulders -->
  <path d="M 80 360 Q 200 260 320 360 Z" fill="url(#ringGrad)" opacity="0.9"/>
  <!-- Neck -->
  <rect x="175" y="220" width="50" height="50" rx="8" fill="#F8FAFC"/>
  <!-- Head -->
  <circle cx="200" cy="175" r="75" fill="#F8FAFC"/>
  <!-- Hair style -->
  <path d="M 125 170 Q 200 80 275 160 Q 240 100 180 110 Z" fill="#0F172A"/>
  <!-- Eyeglasses -->
  <rect x="150" y="155" width="40" height="28" rx="8" fill="none" stroke="#0F172A" stroke-width="6"/>
  <rect x="210" y="155" width="40" height="28" rx="8" fill="none" stroke="#0F172A" stroke-width="6"/>
  <line x1="190" y1="168" x2="210" y2="168" stroke="#0F172A" stroke-width="6"/>
  <!-- Smile -->
  <path d="M 180 215 Q 200 232 220 215" fill="none" stroke="#0F172A" stroke-width="5" stroke-linecap="round"/>

  <!-- Code symbol badge on chest -->
  <rect x="155" y="295" width="90" height="40" rx="12" fill="#0F172A" stroke="#06B6D4" stroke-width="3"/>
  <text x="200" y="322" font-family="'Courier New', monospace" font-size="20" font-weight="bold" fill="#38BDF8" text-anchor="middle">&lt;DEV/&gt;</text>
</svg>
